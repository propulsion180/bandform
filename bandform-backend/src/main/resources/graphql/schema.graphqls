enum RequestStatus{
    PENDING
    ACCEPTED
    REJECTED
}

enum UserStatus {
    NOBANDRAND
    NOBANDSEL
    BAND
    BANDRAND
    BANDSEL
}

enum UserType{
    OWNER
    ADMIN
    NORMAL
}


type Genre {
    id: ID!
    name: String
}

type Instrument {
    id: ID!
    name: String
}



type User{
    id: ID!
    name: String!
    # Only resolved for the user themselves or a global admin/owner
    # (see UserFieldResolver); null for everyone else.
    email: String
    age: Int!
    city: String!
    country: String!
    description: String!
    role: UserType!
    status: UserStatus!
    # Whether the account is locked out (too many failed logins). Only resolved
    # for the user themselves or a global admin/owner (see UserFieldResolver);
    # null for everyone else.
    locked: Boolean
    # Last-login origin, for the admin monitoring view. Same self/admin-only
    # guard as email/locked; null for everyone else. lastLoginCountry is not yet
    # populated (IP->country resolution deferred).
    lastLoginIp: String
    lastLoginAt: String
    lastLoginCountry: String
    genres: [Genre]!
    instruments: [Instrument]!
    bandMemberships: [BandMember]!
}

type BandPosition{
    id: ID!
    band: Band!
    instrument: Instrument!
    description: String
    filled: Boolean!
    filledBy: User
}

type Band {
    id: ID!
    name: String!
    description: String
    city: String
    country: String
    genres: [Genre]!
    members: [BandMember]!
    openPositions: [BandPosition]!
    joinRequests: [JoinRequest]!
    owner: User
}

type BandMember {
    id: ID!
    user: User!
    band: Band!
    instruments: [Instrument]
    joinedDate: String!
    role: String
}

type JoinRequest{
    id: ID!
    user: User!
    band: Band!
    position: BandPosition
    interestedInstruments: [Instrument]!
    message: String
    requestedDate: String
    status: RequestStatus!
    invitedByBand: Boolean!
    proposedRole: String
}

type LoginResult {
    user: User!
}

type Notification {
    id: ID!
    user: User!
    message: String!
    read: Boolean!
    sender: String!
}

type Message {
    id: ID!
    band: Band!
    sender: User!
    body: String!
    sentAt: String!
}

type RecentLogin {
    userId: ID!
    name: String!
    ip: String
    country: String
    at: String
}

# Admin-only runtime + application metrics snapshot (see MonitoringResolver).
# Byte/cumulative values are Float to avoid 32-bit Int overflow.
type SystemMetrics {
    # System & JVM
    systemCpuLoad: Float!
    processCpuLoad: Float!
    availableProcessors: Int!
    systemMemoryTotal: Float!
    systemMemoryFree: Float!
    heapUsed: Float!
    heapMax: Float!
    nonHeapUsed: Float!
    threadCount: Int!
    peakThreadCount: Int!
    daemonThreadCount: Int!
    gcCount: Float!
    gcTimeMs: Float!
    uptimeMs: Float!
    startTime: String!
    diskTotal: Float!
    diskFree: Float!
    # Database
    dbReachable: Boolean!
    dbPoolActive: Int
    dbPoolIdle: Int
    dbPoolPending: Int
    dbPoolTotal: Int
    dbPoolMax: Int
    # Traffic (since startup)
    graphqlRequests: Float!
    graphqlErrors: Float!
    graphqlAvgLatencyMs: Float!
    # App & Security
    totalUsers: Int!
    totalBands: Int!
    openPositions: Int!
    pendingJoinRequests: Int!
    totalMessages: Int!
    activeSessions: Int!
    lockedAccounts: Int!
    usersWithFailedLogins: Int!
    recentLogins: [RecentLogin!]!
}

type Query {
    me: User
    users: [User!]!
    user(id: ID!): User
    bands: [Band!]!
    band(id: ID!): Band
    bandPosition(id: ID!): BandPosition
    positionsInBand(bId: ID!): [BandPosition!]
    membersInBand(bID: ID!): [BandMember!]
    joinRequest(id: ID!): JoinRequest
    userJoinRequests(uID: ID!): [JoinRequest!]
    bandJoinRequests(bID: ID!): [JoinRequest!]
    recommendBand(withinCity: Boolean!, withinCountry: Boolean!, sameGenre: Boolean!, locGenreWeight: Int!): [Band!]!
    recommendUser(bp: ID!, withinCity: Boolean!, withinCountry: Boolean!, sameGenre: Boolean!, singleInstrument: Boolean!, locGenreWeight: Int!): [User!]!
    bandMessages(bandId: ID!, limit: Int, before: ID): [Message!]!
    systemMetrics: SystemMetrics!
}

type Mutation {
    createUser(
        name: String!
        email: String!
        plainPassword: String!
        age: Int!
        city: String!
        country: String!
        description: String!
        genres: [String!]!
        instruments: [String!]!
        status: UserStatus
    ): User!

    updateUser(
        id: ID!,
        name: String
        email: String
        age: Int
        city: String
        country: String
        description: String
        status: UserStatus
        genres: [String!]
        instruments: [String!]
    ): ID

    deleteUser(id: ID!): ID

    unlockUser(id: ID!): Boolean!

    # Admin-only: resets the user's password to a freshly generated temp password,
    # revokes their sessions, and returns the temp password once for the admin to relay.
    adminResetPassword(id: ID!): String!

    createBand(
        name: String!
        description: String!
        city: String!
        country: String!
        genres: [String!]!
    ): Band!

    updateBand(
        id: ID!
        name: String
        description: String
        city: String
        country: String
        genres: [String!]
    ): ID

    deleteBand(id: ID!): ID

    createBandPosition(
        bandId: ID!
        instrumentName: String!
        description: String!
    ): BandPosition

    updateBandPosition(
        bpId: ID!
        bId: ID
        instrument: String
        description: String
        filled: Boolean
        fillerId: ID
    ): ID

    deleteBandPosition(pbId: ID!): ID

    createBandMember(
        bID: ID!
        uID: ID!
        instrumentNames: [String]
        role: String
    ): BandMember

    deleteBandMember(bmID: ID!): ID

    createJoinRequest(
        uID: ID!
        bID: ID!
        bpId: ID!
        interestedInstruments: [String!]
        message: String
    ): JoinRequest

    inviteToBand(
        bID: ID!
        bpId: ID!
        uID: ID!
        proposedRole: String!
        message: String
    ): JoinRequest

    deleteJoinRequest(id: ID): ID

    reject(id: ID!): ID

    accept(
        id: ID!
        bandRole: String
    ): ID

    login(name: String!, password: String!): LoginResult!
    logout: Boolean!
    changePassword(newPassword: String!): Boolean!

    randomizedBandCreator(
        yourUID: ID!
        yourInstrument: String!
        yourRole: String
        name: String!
        instruments: [String!]!
        city: String!
        country: String!
        genres: [String!]!
        description: String!
        instrumentSearchDepth: Int!
    ): Band!

    sendMessage(bandId: ID!, body: String!): Message!

    issueWsTicket: String!
}

type Subscription {
    notifications(ticket: String!): Notification!
    messageAdded(bandId: ID!, ticket: String!): Message!
}
