enum RequestStatus{
    PENDING
    ACCEPTED
    REJECTED
}

enum UserStatus {
    NOBANDRAND
    NOBANDSEL
    BAND
    BANDRAND
    BANDSEL
}

enum UserType{
    OWNER
    ADMIN
    NORMAL
}


type Genre {
    id: ID!
    name: String
}

type Instrument {
    id: ID!
    name: String
}



type User{
    id: ID!
    name: String!
    email: String!
    age: Int!
    city: String!
    country: String!
    description: String!
    role: UserType!
    status: UserStatus!
    genres: [Genre]!
    instruments: [Instrument]!
    bandMemberships: [BandMember]!
}

type BandPosition{
    id: ID!
    band: Band!
    instrument: Instrument!
    description: String
    filled: Boolean!
    filledBy: User
}

type Band {
    id: ID!
    name: String!
    description: String
    city: String
    country: String
    genres: [Genre]!
    members: [BandMember]!
    openPositions: [BandPosition]!
    joinRequests: [JoinRequest]!
    owner: User
}

type BandMember {
    id: ID!
    user: User!
    band: Band!
    instruments: [Instrument]
    joinedDate: String!
    role: String
}

type JoinRequest{
    id: ID!
    user: User!
    band: Band!
    position: BandPosition
    interestedInstruments: [Instrument]!
    message: String
    requestedDate: String
    status: RequestStatus!
    invitedByBand: Boolean!
    proposedRole: String
}

type LoginResult {
    user: User!
}

type Notification {
    id: ID!
    user: User!
    message: String!
    read: Boolean!
    sender: String!
}

type Message {
    id: ID!
    band: Band!
    sender: User!
    body: String!
    sentAt: String!
}

type Query {
    me: User
    users: [User!]!
    user(id: ID!): User
    bands: [Band!]!
    band(id: ID!): Band
    bandPosition(id: ID!): BandPosition
    positionsInBand(bId: ID!): [BandPosition!]
    membersInBand(bID: ID!): [BandMember!]
    joinRequest(id: ID!): JoinRequest
    userJoinRequests(uID: ID!): [JoinRequest!]
    bandJoinRequests(bID: ID!): [JoinRequest!]
    recommendBand(withinCity: Boolean!, withinCountry: Boolean!, sameGenre: Boolean!, locGenreWeight: Int!): [Band!]!
    recommendUser(bp: ID!, withinCity: Boolean!, withinCountry: Boolean!, sameGenre: Boolean!, singleInstrument: Boolean!, locGenreWeight: Int!): [User!]!
    bandMessages(bandId: ID!, limit: Int, before: ID): [Message!]!
}

type Mutation {
    createUser(
        name: String!
        email: String!
        plainPassword: String!
        age: Int!
        city: String!
        country: String!
        description: String!
        genres: [String!]!
        instruments: [String!]!
        status: UserStatus
    ): User!

    updateUser(
        id: ID!,
        name: String
        email: String
        age: Int
        city: String
        country: String
        description: String
        status: UserStatus
        genres: [String!]
        instruments: [String!]
    ): ID

    deleteUser(id: ID!): ID

    createBand(
        name: String!
        description: String!
        city: String!
        country: String!
        genres: [String!]!
    ): Band!

    updateBand(
        id: ID!
        name: String
        description: String
        city: String
        country: String
        genres: [String!]
    ): ID

    deleteBand(id: ID!): ID

    createBandPosition(
        bandId: ID!
        instrumentName: String!
        description: String!
    ): BandPosition

    updateBandPosition(
        bpId: ID!
        bId: ID
        instrument: String
        description: String
        filled: Boolean
        fillerId: ID
    ): ID

    deleteBandPosition(pbId: ID!): ID

    createBandMember(
        bID: ID!
        uID: ID!
        instrumentNames: [String]
        role: String
    ): BandMember

    deleteBandMember(bmID: ID!): ID

    createJoinRequest(
        uID: ID!
        bID: ID!
        bpId: ID!
        interestedInstruments: [String!]
        message: String
    ): JoinRequest

    inviteToBand(
        bID: ID!
        bpId: ID!
        uID: ID!
        proposedRole: String!
        message: String
    ): JoinRequest

    deleteJoinRequest(id: ID): ID

    reject(id: ID!): ID

    accept(
        id: ID!
        bandRole: String
    ): ID

    login(name: String!, password: String!): LoginResult!
    logout: Boolean!
    changePassword(newPassword: String!): Boolean!

    randomizedBandCreator(
        yourUID: ID!
        yourInstrument: String!
        yourRole: String
        name: String!
        instruments: [String!]!
        city: String!
        country: String!
        genres: [String!]!
        description: String!
        instrumentSearchDepth: Int!
    ): Band!

    sendMessage(bandId: ID!, body: String!): Message!

    issueWsTicket: String!
}

type Subscription {
    notifications(ticket: String!): Notification!
    messageAdded(bandId: ID!, ticket: String!): Message!
}
